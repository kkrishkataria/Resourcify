# ==============================================================================
# Resourcify Backend Environment Configuration
# ==============================================================================

# Server Runtime Settings
PORT=5001
NODE_ENV=development

# Database Mode:
# - 'local-memory' (default for instant zero-dependency local dev/tests, simulates DynamoDB)
# - 'dynamodb' (for AWS Cloud or local DynamoDB Local container)
DB_MODE=local-memory

# ------------------------------------------------------------------------------
# AWS Configuration (Used when DB_MODE=dynamodb or running in AWS Lambda)
# AWS Mumbai Region: ap-south-1
# ------------------------------------------------------------------------------
AWS_REGION=ap-southeast-2

# Optional: Only needed when testing with local DynamoDB container (e.g. http://localhost:8000)
# Leave empty or commented out when running in AWS Cloud
# AWS_DYNAMODB_ENDPOINT=http://localhost:8000

# DynamoDB Table Names
DYNAMODB_TABLE_RESOURCES=CampusSlot-Resources
DYNAMODB_TABLE_BOOKINGS=CampusSlot-Bookings
DYNAMODB_TABLE_SLOT_LOCKS=CampusSlot-SlotLocks
DYNAMODB_TABLE_USERS=CampusSlot-Users

# Amazon Cognito Configuration (for production token verification)
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=ap-south-1

# Amazon SNS Notifications Topic ARN (for real-time booking alerts)
SNS_BOOKING_NOTIFICATIONS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:CampusSlot-Notifications

# ------------------------------------------------------------------------------
# Core CampusSlot Booking System Rules
# ------------------------------------------------------------------------------
SLOT_DURATION_MINUTES=30
CHECKIN_GRACE_PERIOD_MINUTES=15
AUTO_RELEASE_CHECK_INTERVAL_MINUTES=5
