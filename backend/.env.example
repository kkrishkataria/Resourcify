# Server Configuration
PORT=5001
NODE_ENV=development

# Storage Mode: 'dynamodb' or 'local-memory' (default: local-memory for zero-dependency instant local development)
DB_MODE=local-memory

# AWS Configuration (when DB_MODE=dynamodb)
AWS_REGION=us-east-1
AWS_DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_RESOURCES=CampusSlot-Resources
DYNAMODB_TABLE_BOOKINGS=CampusSlot-Bookings
DYNAMODB_TABLE_SLOT_LOCKS=CampusSlot-SlotLocks
DYNAMODB_TABLE_USERS=CampusSlot-Users

# Amazon Cognito (in production)
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_CLIENT_ID=exampleclientid12345
COGNITO_REGION=us-east-1

# SNS Configuration for Notifications
SNS_BOOKING_NOTIFICATIONS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:CampusSlot-Notifications

# Booking System Settings
SLOT_DURATION_MINUTES=30
CHECKIN_GRACE_PERIOD_MINUTES=15
AUTO_RELEASE_CHECK_INTERVAL_MINUTES=5
