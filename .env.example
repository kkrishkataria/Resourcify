# ==============================================================================
# Resourcify – Root Environment Variables Reference
# ==============================================================================

# Server Runtime Settings
PORT=5001
NODE_ENV=development

# Database Mode ('local-memory' for local dev, 'dynamodb' for AWS Cloud)
DB_MODE=local-memory

# AWS Cloud Settings (Region: Asia Pacific Sydney ap-southeast-2)
AWS_REGION=ap-southeast-2

# DynamoDB Tables (Free Tier: On-Demand Pay-per-Request)
DYNAMODB_TABLE_RESOURCES=CampusSlot-Resources
DYNAMODB_TABLE_BOOKINGS=CampusSlot-Bookings
DYNAMODB_TABLE_SLOT_LOCKS=CampusSlot-SlotLocks
DYNAMODB_TABLE_USERS=CampusSlot-Users

# Amazon Cognito Authentication
COGNITO_USER_POOL_ID=ap-southeast-2_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=ap-southeast-2

# Amazon SNS Alerts Topic
SNS_BOOKING_NOTIFICATIONS_TOPIC_ARN=arn:aws:sns:ap-southeast-2:123456789012:CampusSlot-Notifications

# Frontend Environment Variables (in frontend/.env)
# VITE_API_BASE_URL=https://<api-id>.execute-api.ap-southeast-2.amazonaws.com/api
